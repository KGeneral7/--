# Agent-local state; keep the shared Spec Kit skills tracked.
.agents/*
!.agents/skills/
!.agents/skills/**

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment files and secrets
.env
.env.*
!.env.example

# Build and coverage output
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Spec Kit keeps its own machine-local exclusions in .specify/.gitignore.
